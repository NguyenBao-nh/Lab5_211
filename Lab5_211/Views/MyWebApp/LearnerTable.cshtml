@model IEnumerable<Lab5_211.Models.Learner>
@{
    int pageNum = ViewBag.pageNum ?? 1;
    int pageIndex = ViewBag.pageIndex ?? 1;
    int totalItems = ViewBag.totalItems ?? 0;
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Họ</th>
            <th>Ngành</th>
            <th>Ngày Nhập Học</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Không có học viên nào</td>
            </tr>
        }
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LearnerId</td>
                <td>@s.FirstMidName</td>
                <td>@s.LastName</td>
                <td>@(s.Major != null ? s.Major.MajorName : "")</td>
                <td>@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.LearnerId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@s.LearnerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span class="text-muted">Trang @pageIndex / @pageNum · @totalItems học viên</span>

    <!-- Lưu trạng thái lọc hiện tại để nút chuyển trang gửi kèm -->
    <ul class="pagination mb-0" data-mid="@ViewBag.mid" data-keyword="@ViewBag.keyword">
        <li class="page-item @(pageIndex == 1 ? "disabled" : "")" data-page="@(pageIndex - 1)">
            <a class="page-link" href="#">&laquo;</a>
        </li>
        @for (int i = 1; i <= pageNum; i++)
        {
            <li class="page-item @(i == pageIndex ? "active" : "")" data-page="@i">
                <a class="page-link" href="#">@i</a>
            </li>
        }
        <li class="page-item @(pageIndex == pageNum ? "disabled" : "")" data-page="@(pageIndex + 1)">
            <a class="page-link" href="#">&raquo;</a>
        </li>
    </ul>
</div>
